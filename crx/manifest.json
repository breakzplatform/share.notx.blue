{
  "manifest_version": 3,
  "name": "Redirect Twitter Share to Bluesky",
  "version": "2.0.0",
  "description": "When clicking in a 'Post to Twitter/X' button, replaces the url to post in Bluesky or another client of your choice",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "share-16.png",
      "24": "share-24.png",
      "32": "share-32.png",
      "48": "share-48.png"
    },
    "default_title": "Share this page"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "host_permissions": [
    "*://x.com/intent*",
    "*://twitter.com/intent*",
    "*://x.com/share*",
    "*://twitter.com/share*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "share.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "48": "share-48.png",
    "128": "share-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "share.notx.blue@joseli.to",
      "strict_min_version": "113.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
